{
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.2.5/"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "deno task lume -- -s",
    "art": "deno run -A scripts/gen-art.ts",
    "ai-images": "deno run -A scripts/gen-ai-images.ts",
    "check": "deno check _config.ts src/_lib/*.ts src/_data/*.ts scripts/*.ts",
    "vendor:basecoat": "deno run -A scripts/vendor-basecoat.ts",
    "validate": "deno run -A scripts/validate-data.ts"
  },
  "fmt": {
    "exclude": [
      "_site",
      "src/img"
    ]
  },
  "lint": {
    "exclude": [
      "_site",
      "src/img"
    ]
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  }
}
