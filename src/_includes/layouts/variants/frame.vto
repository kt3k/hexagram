---
layout: layouts/base.vto
---
{{# 太い縁で囲み、掛け軸を表装したように見せる #}}
<article class="v-frame">
  <div class="v-frame-mount">
    <div class="v-frame-inner">
      <header class="v-frame-head">
        {{ comp.gua({ hexagram, size: "md" }) }}
        {{ comp.nameplate({ hexagram, size: "md", showEnglish: true }) }}
      </header>

      {{ comp.art({ hexagram, eager: true, modifier: "v-frame-art" }) }}

      <p class="v-frame-summary summary-line">{{ hexagram.summary }}</p>
      {{ comp.keywords({ hexagram, variant: "outline" }) }}

      <section>
        <p class="section-label">卦辞</p>
        {{ comp.judgment({ hexagram }) }}
      </section>
      <section>
        <p class="section-label">解説</p>
        {{ comp.commentary({ hexagram }) }}
      </section>
      <section>
        <p class="section-label">卦の成り立ち</p>
        {{ comp.trigrams({ hexagram }) }}
      </section>
      <section>
        <p class="section-label">関連する卦</p>
        {{ comp.relations({ hexagram, all: hexagrams }) }}
      </section>
    </div>
  </div>
</article>
